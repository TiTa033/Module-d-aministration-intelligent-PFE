        "jsonBody": "={\n  \"api_key\": \"{{ $json.tavilyKey }}\",\n  \"query\": \"inflation GDP growth unemployment macroeconomic indicators {{ $json.period }}\",\n  \"max_results\": 5,\n  \"search_depth\": \"advanced\"\n}",
