              "name": "period",
              "value": "={{ $('Initialiser variables').first().json.period }}",
              "type": "string"
            },
            {
              "id": "tavilyKey",
              "name": "tavilyKey",
              "value": "={{ $('Initialiser variables').first().json.tavilyKey }}",
              "type": "string"
            },
            {
              "id": "groqKey",
              "name": "groqKey",
              "value": "={{ $('Initialiser variables').first().json.groqKey }}",
              "type": "string"
