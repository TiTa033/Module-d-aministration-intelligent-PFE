          "assignments": [
            {
              "id": "macroRaw",
              "name": "macroRaw",
              "value": "={{ $json.answer ?? '' }}\n={{ $json.results?.map(r => '- ' + r.title + ': ' + (r.content ?? '').substring(0, 300)).join('\\n') ?? '' }}",
