      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "Sauvegarder résultat Macro",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $json.tavilyKey }}\",\n  \"query\": \"banking sector fintech credit risk financial regulation {{ $json.period }}\",\n  \"max_results\": 5,\n  \"search_depth\": \"advanced\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000009",
      "name": "Tavily — Sectoriel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Sauvegarder résultat Macro').first().json;\nconst period = prev.period;\nconst centralBank = prev.centralBankRaw || '';\nconst macro = prev.macroRaw || '';\nconst sectoriel = ($input.first().json.answer ?? '') + '\\n' +\n  ($input.first().json.results?.map(r => '- ' + r.title + ': ' + (r.content ?? '').substring(0, 300)).join('\\n') ?? '');\n\nconst systemPrompt = `Tu es un analyste financier expert. Tu analyses les données macro-économiques\net sectorielles pour aider les équipes de gestion des risques à adapter leurs règles métier.\nRéponds uniquement en français, de façon claire, structurée et orientée décision.`;\n\nconst userPrompt = `PÉRIODE D'ANALYSE : ${period}\\n\\n` +\n  `=== Banque Centrale ===\\n${centralBank.substring(0, 1500)}\\n\\n` +\n  `=== Macro-économique ===\\n${macro.substring(0, 1500)}\\n\\n` +\n  `=== Sectoriel ===\\n${sectoriel.substring(0, 1500)}\\n\\n` +\n  `STRUCTURE DE L'ANALYSE ATTENDUE :\\n\\n` +\n  `[1. RÉSUMÉ EXÉCUTIF]\\nPoints clés pour les décideurs (3-4 bullet points)\\n\\n` +\n  `[2. IMPACT BANQUE CENTRALE]\\n- Décisions de politique monétaire et impact sur les règles de scoring crédit\\n\\n` +\n  `[3. INDICATEURS MACRO-ÉCONOMIQUES]\\n- Tendances inflation / croissance / emploi et implications pour les règles de risque\\n\\n` +\n  `[4. ANALYSE SECTORIELLE]\\n- Évolutions réglementaires ou sectorielles et recommandations d'ajustement\\n\\n` +\n  `[5. RECOMMANDATIONS CONCRÈTES]\\n- 3 actions spécifiques pour adapter les règles métier\\n\\nSois factuel, précis et orienté vers l'action métier.`;\n\nreturn [{\n  json: {\n    systemPrompt,\n    userPrompt,\n    period,\n    centralBank: centralBank.substring(0, 500),\n    macro: macro.substring(0, 500),\n    sectoriel: sectoriel.substring(0, 500),\n    groqKey: prev.groqKey,\n    springBootUrl: prev.springBootUrl,\n    ingestSecret: prev.ingestSecret\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "Construire le prompt LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.groqKey }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"temperature\": 0.7,\n  \"max_tokens\": 1500,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"{{ $json.systemPrompt }}\" },\n    { \"role\": \"user\",   \"content\": \"{{ $json.userPrompt }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000011",
      "name": "Groq — Générer l'analyse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2600, 300]
    },
    {
      "parameters": {
        "jsCode": "const llmResponse = $input.first().json;\nconst promptData = $('Construire le prompt LLM').first().json;\n\nconst analysis = llmResponse.choices?.[0]?.message?.content ?? '';\nconst period = promptData.period;\nconst title = `Analyse Externe – ${period} [Banque Centrale · Macro-éco · Sectoriel] (via n8n)`;\n\nreturn [{\n  json: {\n    title,\n    description: analysis.substring(0, 2000),\n    confidence: 0.85,\n    period,\n    sources: ['Tavily Web Search', 'Groq / GPT-OSS-120b', 'Banque Centrale', 'Macro-éco', 'Sectoriel'],\n    springBootUrl: promptData.springBootUrl,\n    ingestSecret: promptData.ingestSecret\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000012",
      "name": "Formater le payload Spring Boot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.springBootUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-N8n-Ingest-Secret", "value": "={{ $json.ingestSecret }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.title }}\",\n  \"description\": \"{{ $json.description }}\",\n  \"confidence\": {{ $json.confidence }},\n  \"period\": \"{{ $json.period }}\",\n  \"sources\": {{ JSON.stringify($json.sources) }}\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000013",
      "name": "POST → Spring Boot /ingest-insight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "status-ok",
              "leftValue": "={{ $response.statusCode }}",
              "rightValue": 202,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000014",
      "name": "Succès ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3500, 300]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000015",
      "name": "✅ Insight sauvegardé",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3800, 200]
    },
    {
      "parameters": {
        "errorMessage": "=Spring Boot a refusé l'insight (HTTP {{ $response.statusCode }}) — vérifier X-N8n-Ingest-Secret et les logs."
